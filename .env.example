# Token required by POST /api/readings. Generate one, e.g.:
#   openssl rand -hex 32
# or without openssl:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
API_TOKEN=replace-with-a-long-random-token

# Host port for the web UI (default 8080).
PORT=8080

# How long readings are kept, in days (default 30).
RETENTION_DAYS=30
